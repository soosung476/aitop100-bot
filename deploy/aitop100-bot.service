# systemd 서비스 설정: 서버가 재부팅되거나 프로그램이 죽어도 FastAPI를 자동으로 다시 켠다
[Unit]
Description=AITOP100 bot (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/aitop100-bot
EnvironmentFile=-/home/ubuntu/aitop100-bot/.env
ExecStart=/home/ubuntu/aitop100-bot/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
